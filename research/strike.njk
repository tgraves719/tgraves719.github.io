  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl tracking-tight uppercase font-bold text-white mb-4" style="letter-spacing: 0.1em;">The Safeway Strike</h1>
    <p class="text-lg text-gray-400 mb-12">Minimizing Misinformation in the Workplace: Worker-Controlled AI Tools Augmenting Contract Literacy</p>

    {# The recordings. Titles, order and durations: _data/strikePlaylist.json (tools/import-strike-audio.py). #}
    <div id="songs" data-player data-artist="{{ PL.artist }}" data-album="Safeway Strike 2025" data-cover="{{ PL.cover }}"
