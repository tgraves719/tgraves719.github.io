        <div class="min-w-0 flex-1">
          <p data-now class="text-white font-semibold truncate">{{ PL.tracks[0].title }}</p>
          <p class="text-gray-500 text-sm">{{ PL.artist }}</p>
          <div class="player-controls mt-3 flex items-center gap-2">
            <button type="button" data-prev aria-label="Previous" class="p-2 text-gray-400 hover:text-white"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg></button>
            <button type="button" data-play aria-label="Play or pause" class="play w-12 h-12 rounded-full flex items-center justify-center text-black">
