---
layout: base.njk
title: Music
permalink: /music/
instrument: true
---
<section class="py-16">
  <h1 class="text-3xl tracking-tight mb-6 uppercase font-bold text-white" style="letter-spacing: 0.1em;">Music</h1>
  <p class="max-w-3xl text-lg text-gray-300">classically trained, electronically adopted and a jazz lover at heart, i produce, play trumpet and sing.</p>

  <div class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-8 p-2">
    {% for m in [
      { title: "Safeway Strike 2025", href: "/research/strike/#songs", image: "/images/strike/picket-01.webp" },
      { title: "Portraits of Change: a Mixed Reality Music Recital", href: "/work/portraits-of-change/", image: "/images/portraits/hoag-hall-stage.jpg" },
      { title: "Worker-Controlled AI Tools Augmenting Contract Literacy", href: "/research/karl/#song" },
      { title: "Beyond Binary", href: "/work/beyond-binary/", image: "/images/cards/beyond-binary.jpg" }
    ] %}
    {% if m.href %}<a href="{{ m.href }}" class="card static-rainbow bg-[var(--color-bg-card)] rounded-xl flex flex-col transition-transform duration-300 hover:-translate-y-1">{% else %}<div class="card static-rainbow bg-[var(--color-bg-card)] rounded-xl flex flex-col">{% endif %}
      {% if m.image %}<div class="m-3 overflow-hidden rounded-xl aspect-video"><img src="{{ m.image }}" alt="{{ m.title }}" class="w-full h-full object-cover"></div>{% endif %}
      <h2 class="p-6 text-lg font-semibold text-white uppercase tracking-wide">{{ m.title }}</h2>
    {% if m.href %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>
</section>
