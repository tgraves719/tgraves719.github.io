  "key": [
    {
      "term": "Ch#",
      "def": "Indicates which MIDI channel this specific mic’d instrument will be controlling."
    },
    {
      "term": "(T#)",
      "def": "Tracked instrument with Vive Tracker either attached to instrument, near it, or mounted on a mic stand."
    },
    {
      "term": "(E)",
      "def": "Environmental effects will be used without the need for a tracker but will still need a phantom-powered microphone to go through the MIDI conversion system."
    }
  ],
