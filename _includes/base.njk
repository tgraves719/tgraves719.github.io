      document.addEventListener('click', (e) => {
        const a = e.target.closest && e.target.closest('a.yt-lite');
        if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const f = document.createElement('iframe');
