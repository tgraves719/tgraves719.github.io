<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if title %} - Thomas J Graves{% endif %}</title>
  <meta name="description" content="{{ description or 'i build computational models of human practices. what does the model do to the practice, and whom does the resulting system serve?' }}">
  <!-- Tailwind and fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    {#
      The whole site is one instrument (September 2026). The particle field and the
      mute are on every page, and the site moves between pages by swapping <main>
      without reloading, so a song a visitor starts keeps playing while they read and
      the field keeps listening to it. The site makes no sound of its own. (MIDI input
      lives in music-field.js as MusicField.connectMidi(), with no control on the page
      for now; it loads Tone.js only when called.)

      site-audio.js owns the sound for the whole visit; player.js draws the players
      on the pages as views of it. Nothing plays that the visitor did not start.
      (`instrument: true` in a page's front matter no longer changes anything.)
    #}
    {# Development chatter stays available but silent: a visitor who opens the
       console on a portfolio should find it empty, not narrated in emoji. #}
    <script>window.DEBUG = false;</script>
    <script>window.HAS_INSTRUMENT = true;</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="/assets/js/site-audio.js"></script>
    <script src="/assets/js/video-listen.js"></script>
    <script src="/assets/js/frame-listen.js"></script>
    <script src="/assets/js/music-field.js"></script>
    <script src="/assets/js/player.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-secondary: #334155;
      --color-border: #27272A;
      --color-bg-card: #18181B;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0A0A0A;
      color: #E0E0E0;
    }

    /* A reader who has asked their system for less motion has said something
       about how they read. The rainbow is identity and stays; the movement
       under it is decoration and goes. */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      #bg-canvas { display: none; }
    }

    /* Two controls set focus:outline-none and replaced it with nothing, so the
       keyboard position vanished on them. One explicit ring for every
       interactive element, rather than trusting a default the dark background
       can swallow. */
    a:focus-visible, button:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 3px;
      border-radius: 4px;
    }
    #bg-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -10;
    }
    .interactive-rainbow {
      position: relative;
      z-index: 1;
      overflow: hidden;
      border: 4px solid transparent;
      color: white;
    }
    .interactive-rainbow::before {
      content: '';
      position: absolute;
      z-index: -2;
      left: var(--x, 50%);
      top: var(--y, 50%);
      width: 250%;
      padding-bottom: 250%;
      transform: translate(-50%, -50%);
      background: conic-gradient(
        from var(--angle, 0deg),
        #ff2a2a, #ff8000, #ffff00, #40ff00,
        #00ffff, #0080ff, #8000ff, #ff00ff, #ff2a2a
      );
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .interactive-rainbow::after {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 3px;
      background: var(--color-bg-card);
      border-radius: inherit;
    }
    /* Default state (sound OFF) - rainbow only on hover */
    .interactive-rainbow:hover::before {
      opacity: 0.8;
    }
    .nav-link.active.interactive-rainbow::before {
      opacity: 0.9;
    }

    /* Button elements - no rainbow by default, only on hover */
    button.interactive-rainbow:hover::before { 
      opacity: 0.9; 
    }

    /* Special case: toggled portrait buttons stay on */
    #toggle-devlog-btn.toggled::before,
    #toggle-collaborators-btn.toggled::before {
      opacity: 0.6;
    }
    #toggle-devlog-btn.toggled:hover::before,
    #toggle-collaborators-btn.toggled:hover::before {
      opacity: 0.9;
    }

    /* Special styling for Reality Engine button - always glowing with interactivity */
    #reality-engine-btn {
      --angle: 45deg;
      --x: 50%;
      --y: 50%;
    }
    #reality-engine-btn::before {
      opacity: 0.9 !important;
    }
    #reality-engine-btn:hover::before {
      opacity: 1.0 !important;
    }

    /* When sound is enabled - dim/faded rainbow buttons */
    body.sound-is-on .interactive-rainbow:hover::before {
      opacity: 0.15;
    }
    body.sound-is-on .nav-link.active.interactive-rainbow::before {
      opacity: 0.25;
    }
    body.sound-is-on button.interactive-rainbow:hover::before { 
      opacity: 0.2; 
    }

    /* Sound enabled: toggled portrait buttons stay dimly visible */
    body.sound-is-on #toggle-devlog-btn.toggled::before,
    body.sound-is-on #toggle-collaborators-btn.toggled::before {
      opacity: 0.1;
    }
    body.sound-is-on #toggle-devlog-btn.toggled:hover::before,
    body.sound-is-on #toggle-collaborators-btn.toggled:hover::before {
      opacity: 0.2;
    }
    body.sound-is-on #reality-engine-btn::before {
      opacity: 0.2 !important;
    }
    body.sound-is-on #reality-engine-btn:hover::before {
      opacity: 0.4 !important;
    }

    /* Static rainbow borders for cards - no cursor following */
    .static-rainbow {
      position: relative;
      z-index: 1;
      overflow: hidden;
      border: 3px solid transparent;
      color: white;
    }
    .static-rainbow::before {
      content: '';
      position: absolute;
      z-index: -2;
      left: 50%;
      top: 50%;
      width: 400%;
      padding-bottom: 400%;
      background: conic-gradient(
        from 0deg,
        #ff2a2a, #ff8000, #ffff00, #40ff00,
        #00ffff, #0080ff, #8000ff, #ff00ff, #ff2a2a
      );
      opacity: 0;
      transition: opacity 0.2s ease;
      animation: rainbow-rotate 3s linear infinite;
    }
    .static-rainbow::after {
      content: '';
      position: absolute;
      z-index: -1;
      inset: 3px;
      background: var(--color-bg-card);
      border-radius: inherit;
    }
    .static-rainbow:hover::before {
      opacity: 0.8;
    }

    /* When sound is enabled - dim static rainbow cards too */
    body.sound-is-on .static-rainbow:hover::before {
      opacity: 0.15;
    }

    /* Prose styles for markdown content */
    .prose {
      color: var(--tw-prose-body);
      max-width: 65ch;
    }
    .prose p {
      margin-top: 1.25em;
      margin-bottom: 1.25em;
      line-height: 1.75;
    }
    .prose blockquote {
      font-style: italic;
      border-left: 4px solid var(--color-border);
      padding-left: 1em;
      margin: 1.6em 0;
      color: #d1d5db;
    }
    .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
      color: white;
      font-weight: 700;
      margin-top: 2em;
      margin-bottom: 1em;
      line-height: 1.25;
    }
    .prose h1 { font-size: 2.25em; }
    .prose h2 { font-size: 1.875em; }
    .prose h3 { font-size: 1.5em; }
    .prose h4 { font-size: 1.25em; }
    .prose strong {
      color: white;
      font-weight: 600;
    }
    .prose em {
      font-style: italic;
    }
    .prose ul, .prose ol {
      margin: 1.25em 0;
      padding-left: 1.625em;
    }
    .prose li {
      margin: 0.5em 0;
    }
    .prose a {
      color: #60a5fa;
      text-decoration: underline;
    }
    .prose a:hover {
      color: #93c5fd;
    }
    .prose code {
      background: rgba(255, 255, 255, 0.1);
      padding: 0.125em 0.25em;
      border-radius: 0.25em;
      font-size: 0.875em;
    }
    .prose pre {
      background: rgba(0, 0, 0, 0.5);
      padding: 1em;
      border-radius: 0.5em;
      overflow-x: auto;
      margin: 1.5em 0;
    }
    .prose pre code {
      background: none;
      padding: 0;
    }
    
    /* Fast fade transitions for portrait sections */
    #devlog-section, #collaborators-section, #core-concepts-section {
      transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
      opacity: 1;
      visibility: visible;
    }
    #devlog-section.hidden, #collaborators-section.hidden, #core-concepts-section.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    
    @keyframes rainbow-rotate {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }
    

    /* Loading Animation Styles */
    #loading-overlay {
      transition: opacity 0.3s ease-in-out;
    }
    #explosion-background.exploding {
      opacity: 1;
      animation: color-explosion 0.8s forwards;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    @keyframes color-explosion {
      0% { background: radial-gradient(circle, #ff2a2a 0%, transparent 10%); }
      20% { background: radial-gradient(circle, #ffff00 20%, #8000ff 40%, transparent 60%); }
      40% { background: radial-gradient(circle, #00ffff 40%, #ff8000 60%, transparent 80%); }
      60% { background: radial-gradient(circle, #8000ff 60%, #00ffff 80%, transparent 100%); }
      80% { background: radial-gradient(circle, #ff2a2a 80%, #ffff00 100%, transparent 120%); }
      100% { background: transparent; opacity: 0; }
    }

    /* Aspect ratio utilities for proper YouTube video sizing */
    .aspect-w-16 {
      position: relative;
      padding-bottom: calc(9 / 16 * 100%); /* 16:9 aspect ratio */
      height: 0;
    }
    .aspect-w-16 iframe,
    .aspect-w-16 video,
    .aspect-w-16 img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Ensure minimum height for 720p videos - only apply to video container divs in main content */
    @media (min-width: 640px) {
      .prose .aspect-w-16 {
        padding-bottom: 405px; /* 720px * 9/16 = 405px */
        height: auto;
        min-height: 405px;
      }
    }
  </style>
</head>
