        update() {
          const q = SiteAudio.queue, t = SiteAudio.track;
          this.el.classList.toggle('hidden', !t);
          this.el.classList.toggle('flex', !!t);
          if (!t) return;
          this.title.textContent = t.title;
          this.title.href = q.url;
          document.getElementById('np-play').classList.toggle('hidden', SiteAudio.playing);
