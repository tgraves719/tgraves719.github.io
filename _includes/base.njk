      // Page Transition System
      const PageTransition = {
        isTransitioning: false,

        async navigateToPage(url, pushState = true) {
          if (this.isTransitioning) {
            window.DEBUG && console.log('📄 Navigation already in progress, allowing concurrent requests');
          }
          this.isTransitioning = true;

          try {
            // Show loading overlay
            const overlay = document.getElementById('page-transition-overlay');
            const mainContent = document.getElementById('main-content');

            overlay.style.pointerEvents = 'all';
            overlay.style.opacity = '0.3';
            mainContent.style.opacity = '0.7';

            // Fetch new page content
            const response = await fetch(url);
            if (!response.ok) throw new Error('Failed to load page');

            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // Extract the new content and title
            const newMainContent = doc.querySelector('main');
            const newTitle = doc.querySelector('title')?.textContent || 'Thomas Graves';

            if (!newMainContent) throw new Error('Invalid page structure');

            // Every page is swapped in, never reloaded: a reload would stop the music.
            // Every page shares this <head> now, and the scripts inside the new
            // content are run below, after the swap.

            // Update page title and URL
            document.title = newTitle;
            if (pushState) {
              history.pushState({ url }, '', url);
            }

            // Close mobile menu if open
            if (typeof MobileMenu !== 'undefined') {
              MobileMenu.closeMenu();
            }

            // Trigger visual transition effects
            this.triggerTransitionEffects();

            // Fade out completely
            mainContent.style.opacity = '0';

            // Wait for fade out (faster)
            await new Promise(resolve => setTimeout(resolve, 150));

            // Replace content
            mainContent.innerHTML = newMainContent.innerHTML;
            mainContent.className = newMainContent.className;

            // Scripts set by innerHTML do not run; run the page's own (the post back
            // link) as fresh elements. The players and videos are handled site-wide.
            mainContent.querySelectorAll('script').forEach((old) => {
              const s = document.createElement('script');
              for (const { name, value } of old.attributes) s.setAttribute(name, value);
              s.textContent = old.textContent;
              old.replaceWith(s);
            });

            // Land where a page load would: at the fragment if there is one, else the top.
            const hash = new URL(url, location.href).hash;
            const anchor = hash && document.getElementById(decodeURIComponent(hash.slice(1)));
            if (anchor) anchor.scrollIntoView(); else window.scrollTo(0, 0);

            // Tell the page's views (the players) that a page arrived, and give the
            // new frames the mute.
            document.dispatchEvent(new CustomEvent('site:page'));
            if (window.SiteAudio) SiteAudio.reach();

            // Update active page for music and camera
            const path = url;
            let newPageId;
            if (path.includes('/work')) {
              newPageId = 'work';
            } else if (path.includes('/about')) {
              newPageId = 'about';
            } else if (path.includes('/blog')) {
              newPageId = 'blog';
            } else {
              newPageId = 'hero';
            }

            AppState.activePage = newPageId;

            // Animate camera to new page position
            this.animateCameraForPage(newPageId);

            // Reinitialize page-specific functionality
            this.initializePageSpecificScripts();

            // Reinitialize interactive effects for new elements
            if (typeof InteractiveEffects !== 'undefined') {
              InteractiveEffects.init();
            }

            // Fade in new content
            overlay.style.opacity = '0';
            mainContent.style.opacity = '1';

            // Clean up overlay (faster)
            setTimeout(() => {
              overlay.style.pointerEvents = 'none';
            }, 200);

          } catch (error) {
            console.error('Navigation error:', error);
            // Fallback to normal navigation
            window.location.href = url;
          } finally {
            this.isTransitioning = false;
          }
        },

        init() {
          // Intercept navigation clicks
          document.addEventListener('click', (e) => {
            const link = e.target.closest('a[href]');
            if (!link) return;

            const href = link.getAttribute('href');

            // Only intercept internal links
            if (!href || href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
              return;
            }

            // Don't intercept if ctrl/cmd/shift clicked (user wants new tab)
            if (e.ctrlKey || e.metaKey || e.shiftKey) return;

            // Leave a click alone if a page already handled it (the playlist's
            // track links), if it opens elsewhere or downloads, or if it is not a
            // page of this site at all. Those used to be fetched whole as text --
            // a 6 MB track, a 23 MB PDF -- then fail and load a second time.
            if (e.defaultPrevented || link.target || link.hasAttribute('download')) return;
            const path = href.split(/[?#]/)[0];
            if (!(path.endsWith('/') || path.endsWith('.html')) || path.startsWith('/instruments/')) return;

            e.preventDefault();
            this.navigateToPage(href);
          });

          // Handle browser back/forward buttons
          window.addEventListener('popstate', (e) => {
            if (e.state && e.state.url) {
              this.navigateToPage(e.state.url, false);
            } else {
              this.navigateToPage(window.location.pathname, false);
            }
          });

          // Store initial state
          history.replaceState({ url: window.location.pathname }, '', window.location.pathname);
        },

        initializePageSpecificScripts() {
          // Initialize project page toggle functionality
          this.initProjectPageToggles();

          // Initialize Reality Engine button if we're on the home page
          this.initRealityEngineButton();
          
          // Initialize blog sort button
          this.initBlogSortButton();
        },

        initRealityEngineButton() {
          // Reality Engine Button with Loading System - only initialize if button exists
          const realityEngineBtn = document.getElementById('reality-engine-btn');
          const noVrModal = document.getElementById('no-vr-modal');
          const closeNoVrModalBtn = document.getElementById('close-no-vr-modal');

          if (realityEngineBtn) {
            // Remove any existing event listeners to prevent duplicates
            const newRealityEngineBtn = realityEngineBtn.cloneNode(true);
            realityEngineBtn.parentNode.replaceChild(newRealityEngineBtn, realityEngineBtn);

            // Let InteractiveEffects handle this button with its normal initialization
            if (window.InteractiveEffects) {
              // Simply re-run init to pick up the new element
              InteractiveEffects.rainbowElements = Array.from(document.querySelectorAll('.interactive-rainbow'));
              
              // Find and re-initialize just this button
              const rect = newRealityEngineBtn.getBoundingClientRect();
              Object.assign(newRealityEngineBtn.dataset, {
                angle: '0',
                x: rect.width / 2,
                y: rect.height / 2,
                targetX: rect.width / 2,
                targetY: rect.height / 2,
                velocityX: '0',
                velocityY: '0'
              });

              // Set initial CSS custom properties - reality engine starts at 45 degrees
              newRealityEngineBtn.style.setProperty('--x', `${rect.width / 2}px`);
              newRealityEngineBtn.style.setProperty('--y', `${rect.height / 2}px`);
              newRealityEngineBtn.style.setProperty('--angle', '45deg');

              // Initialize physics object
              newRealityEngineBtn._physics = {
                angle: 45, // Reality Engine button starts with visible rotation
                x: rect.width / 2,
                y: rect.height / 2,
                targetX: rect.width / 2,
                targetY: rect.height / 2,
                velocityX: 0,
                velocityY: 0
              };

              // Re-add event listeners
              newRealityEngineBtn.addEventListener('mouseenter', (e) => InteractiveEffects.onMouseEnter(e));
              newRealityEngineBtn.addEventListener('mouseleave', (e) => InteractiveEffects.onMouseLeave(e));
              newRealityEngineBtn.addEventListener('mousemove', (e) => InteractiveEffects.onMouseMove(e));
            }

            newRealityEngineBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              e.stopPropagation();

              // INSTANT visual feedback - start loading animation immediately
              const loadingPromise = LoadingSystem.showFullLoading('Initializing Reality Engine...');

              // PARALLEL execution - all these happen while animation runs
              const pagePreloadPromise = fetch('/work/');

              const webxrCheckPromise = (async () => {
                try {
                  if (navigator.xr && await navigator.xr.isSessionSupported('immersive-vr')) {
                    window.DEBUG && console.log('✅ WebXR VR session supported');
                    return { hasVR: true };
                  } else {
                    window.DEBUG && console.log('❌ WebXR not supported');
                    return { hasVR: false };
                  }
                } catch (error) {
                  console.error('WebXR check failed:', error);
                  return { hasVR: false };
                }
              })();

              // Wait for all parallel operations to complete
              const [loadingResult, pageResult, webxrResult] = await Promise.all([
                loadingPromise,
                pagePreloadPromise,
                webxrCheckPromise
              ]);

              // Navigate immediately after loading animation completes
              if (webxrResult.hasVR) {
                window.location.href = '/work/';
              } else {
                if (noVrModal) {
                  noVrModal.classList.remove('hidden');
                }
              }
            });
          }

          // Close VR Modal
          if (closeNoVrModalBtn && noVrModal) {
            // Remove existing event listener and add new one
            const newCloseBtn = closeNoVrModalBtn.cloneNode(true);
            closeNoVrModalBtn.parentNode.replaceChild(newCloseBtn, closeNoVrModalBtn);

            newCloseBtn.addEventListener('click', () => {
              noVrModal.classList.add('hidden');
            });
          }
        },

        initProjectPageToggles() {
          // Development log data comes from the Eleventy post collection,
          // emitted as JSON by this layout. Previously this was a hand-kept
          // copy of the same front matter, which drifted: it listed twelve
          // entries against eighteen devlog posts, and one of its ids had no
          // matching post at all, so that card linked to a 404.
          let devlogData = [];
          try {
            const dataEl = document.getElementById('project-posts-data');
            if (dataEl && dataEl.textContent.trim()) {
              devlogData = JSON.parse(dataEl.textContent);
            }
          } catch (err) {
            console.warn('Could not parse project post data:', err);
            devlogData = [];
          }

          // Get toggle elements
          const devlogBtn = document.getElementById('toggle-devlog-btn');
          const collaboratorsBtn = document.getElementById('toggle-collaborators-btn');
          const devlogSection = document.getElementById('devlog-section');
          const collaboratorsSection = document.getElementById('collaborators-section');
          const coreConceptsSection = document.getElementById('core-concepts-section');
          const devlogGrid = document.getElementById('devlog-grid');

          // Populate devlog grid if it exists
          if (devlogGrid && devlogGrid.children.length === 0) {
            devlogGrid.innerHTML = devlogData.map((entry, index) => `
              <div class="sound-interactive interactive-rainbow bg-[var(--color-bg-card)] border border-[var(--color-border)] p-4 flex flex-col rounded-lg group cursor-pointer hover:shadow-lg transition-all duration-300" data-devlog-url="${entry.url}" data-devlog-index="${index}">
                ${(entry.videoId || entry.image) ? `
                <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden mb-3 bg-black">
                  <img src="${entry.videoId ? `https://img.youtube.com/vi/${entry.videoId}/hqdefault.jpg` : entry.image}" alt="Thumbnail for ${entry.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                </div>` : `
                <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden mb-3 bg-gradient-to-br from-purple-900/20 to-blue-900/20 flex items-center justify-center">
                  <p class="text-xs text-gray-500 uppercase tracking-wider">${entry.contentType || 'Post'}</p>
                </div>`}
                <p class="text-xs text-gray-500 mb-2">${entry.date}</p>
                <h4 class="font-bold text-md text-white mb-3 uppercase tracking-wide flex-grow">${entry.title}</h4>
                <p class="text-gray-400 text-sm">${entry.text}</p>
              </div>
            `).join('');

            // Add proper event listeners to devlog cards
            setTimeout(() => {
              const devlogCards = devlogGrid.querySelectorAll('[data-devlog-url]');
              devlogCards.forEach(card => {
                const targetUrl = card.dataset.devlogUrl;
                if (!targetUrl) return;

                card.addEventListener('click', (e) => {
                  e.preventDefault();
                  window.DEBUG && console.log('Devlog card clicked:', targetUrl);

                  // Use normal navigation to preserve browser history
                  window.DEBUG && console.log('🎯 Navigating to devlog post:', targetUrl);
                  window.location.href = targetUrl;
                });
              });

              // Re-initialize interactive effects for new devlog elements
              if (typeof InteractiveEffects !== 'undefined') {
                InteractiveEffects.init();
              }
            }, 150);
          }

          // Remove any existing event listeners to prevent duplicates
          if (devlogBtn) {
            devlogBtn.replaceWith(devlogBtn.cloneNode(true));
            const newDevlogBtn = document.getElementById('toggle-devlog-btn');
            
            // Re-initialize InteractiveEffects for cloned button
            if (window.InteractiveEffects) {
              InteractiveEffects.rainbowElements = Array.from(document.querySelectorAll('.interactive-rainbow'));
              InteractiveEffects.rainbowElements.forEach(el => {
                if (!el._physics && el.classList.contains('interactive-rainbow')) {
                  const rect = el.getBoundingClientRect();
                  Object.assign(el.dataset, {
                    angle: '0', x: rect.width / 2, y: rect.height / 2,
                    targetX: rect.width / 2, targetY: rect.height / 2, velocityX: '0', velocityY: '0'
                  });
                  el.style.setProperty('--x', `${rect.width / 2}px`);
                  el.style.setProperty('--y', `${rect.height / 2}px`);
                  const initialAngle = el.id === 'reality-engine-btn' ? 45 : 0;
                  el.style.setProperty('--angle', `${initialAngle}deg`);
                  el._physics = { angle: initialAngle, x: rect.width / 2, y: rect.height / 2, 
                    targetX: rect.width / 2, targetY: rect.height / 2, velocityX: 0, velocityY: 0 };
                  el.addEventListener('mouseenter', (e) => InteractiveEffects.onMouseEnter(e));
                  el.addEventListener('mouseleave', (e) => InteractiveEffects.onMouseLeave(e));
                  el.addEventListener('mousemove', (e) => InteractiveEffects.onMouseMove(e));
                }
              });
            }
            
            newDevlogBtn.addEventListener('click', () => {
              const isCurrentlyHidden = devlogSection.classList.contains('hidden');
              
              if (isCurrentlyHidden) {
                // Showing devlog - hide collaborators and core concepts
                devlogSection.classList.remove('hidden');
                newDevlogBtn.textContent = 'Hide Development Log';
                newDevlogBtn.classList.add('toggled');
                
                // Always hide collaborators when showing devlog
                if (collaboratorsSection) {
                  collaboratorsSection.classList.add('hidden');
                  const collabBtn = document.getElementById('toggle-collaborators-btn');
                  if (collabBtn) {
                    collabBtn.textContent = 'View Collaborators';
                    collabBtn.classList.remove('toggled');
                  }
                }
                
                // Hide core concepts
                if (coreConceptsSection) {
                  coreConceptsSection.classList.add('hidden');
                }
              } else {
                // Hiding devlog - show core concepts
                devlogSection.classList.add('hidden');
                newDevlogBtn.textContent = 'View Development Log';
                newDevlogBtn.classList.remove('toggled');
                
                // Show core concepts
                if (coreConceptsSection) {
                  coreConceptsSection.classList.remove('hidden');
                }
              }
            });
          }

          if (collaboratorsBtn) {
            collaboratorsBtn.replaceWith(collaboratorsBtn.cloneNode(true));
            const newCollaboratorsBtn = document.getElementById('toggle-collaborators-btn');
            
            // Re-initialize InteractiveEffects for cloned button
            if (window.InteractiveEffects) {
              InteractiveEffects.rainbowElements = Array.from(document.querySelectorAll('.interactive-rainbow'));
              InteractiveEffects.rainbowElements.forEach(el => {
                if (!el._physics && el.classList.contains('interactive-rainbow')) {
                  const rect = el.getBoundingClientRect();
                  Object.assign(el.dataset, {
                    angle: '0', x: rect.width / 2, y: rect.height / 2,
                    targetX: rect.width / 2, targetY: rect.height / 2, velocityX: '0', velocityY: '0'
                  });
                  el.style.setProperty('--x', `${rect.width / 2}px`);
                  el.style.setProperty('--y', `${rect.height / 2}px`);
                  const initialAngle = el.id === 'reality-engine-btn' ? 45 : 0;
                  el.style.setProperty('--angle', `${initialAngle}deg`);
                  el._physics = { angle: initialAngle, x: rect.width / 2, y: rect.height / 2, 
                    targetX: rect.width / 2, targetY: rect.height / 2, velocityX: 0, velocityY: 0 };
                  el.addEventListener('mouseenter', (e) => InteractiveEffects.onMouseEnter(e));
                  el.addEventListener('mouseleave', (e) => InteractiveEffects.onMouseLeave(e));
                  el.addEventListener('mousemove', (e) => InteractiveEffects.onMouseMove(e));
                }
              });
            }
            
            newCollaboratorsBtn.addEventListener('click', () => {
              const isCurrentlyHidden = collaboratorsSection.classList.contains('hidden');
              
              if (isCurrentlyHidden) {
                // Showing collaborators - hide devlog and core concepts
                collaboratorsSection.classList.remove('hidden');
                newCollaboratorsBtn.textContent = 'Hide Collaborators';
                newCollaboratorsBtn.classList.add('toggled');
                
                // Always hide devlog when showing collaborators
                if (devlogSection) {
                  devlogSection.classList.add('hidden');
                  const devlogBtn = document.getElementById('toggle-devlog-btn');
                  if (devlogBtn) {
                    devlogBtn.textContent = 'View Development Log';
                    devlogBtn.classList.remove('toggled');
                  }
                }
                
                // Hide core concepts
                if (coreConceptsSection) {
                  coreConceptsSection.classList.add('hidden');
                }
              } else {
                // Hiding collaborators - show core concepts
                collaboratorsSection.classList.add('hidden');
                newCollaboratorsBtn.textContent = 'View Collaborators';
                newCollaboratorsBtn.classList.remove('toggled');
                
                // Show core concepts
                if (coreConceptsSection) {
                  coreConceptsSection.classList.remove('hidden');
                }
              }
            });
          }
        },

        initBlogSortButton() {
          const sortButton = document.getElementById('sortButton');
          const sortArrow = document.getElementById('sortArrow');
          const blogGrid = document.getElementById('blogGrid');
          
          if (!sortButton || !sortArrow || !blogGrid) return;
          
          // Remove any existing event listeners to prevent duplicates
          const newSortButton = sortButton.cloneNode(true);
          sortButton.parentNode.replaceChild(newSortButton, sortButton);
          
          // Get the new references after replacement
          const freshSortButton = document.getElementById('sortButton');
          const freshSortArrow = document.getElementById('sortArrow');
          
          let currentlyNewest = true; // Posts start newest first
          freshSortArrow.textContent = '↓'; // Show current state
          
          freshSortButton.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Get all posts
            const posts = Array.from(blogGrid.children);
            
            // Sort them
            posts.sort((a, b) => {
              const dateTextA = a.querySelector('p.text-sm.text-gray-500')?.textContent.trim();
              const dateTextB = b.querySelector('p.text-sm.text-gray-500')?.textContent.trim();
              
              if (!dateTextA || !dateTextB) return 0;
              
              const dateA = new Date(dateTextA);
              const dateB = new Date(dateTextB);
              
              if (currentlyNewest) {
                // Currently newest, switch to oldest
                return dateA - dateB; // oldest first
              } else {
                // Currently oldest, switch to newest
                return dateB - dateA; // newest first
              }
            });
            
            // Clear grid and add sorted posts
            blogGrid.innerHTML = '';
            posts.forEach(post => blogGrid.appendChild(post));
            
            // Toggle state and update arrow
            currentlyNewest = !currentlyNewest;
            freshSortArrow.textContent = currentlyNewest ? '↓' : '↑';
          });
        },

        animateCameraForPage(pageId) {
          // Define base camera positions for different pages
          const baseCameraPositions = {
            'hero': { x: 0, y: 0, z: 2 },
            'work': { x: -2, y: 1, z: 3 },
            'about': { x: 2, y: -1, z: 4 },
            'blog': { x: 0, y: 2, z: 3 }
          };

          const basePos = baseCameraPositions[pageId] || baseCameraPositions['hero'];

          // Add randomization for more dynamic transitions
          const randomFactor = 0.5; // How much randomization to apply
          const distanceMultiplier = 1 + (Math.random() - 0.5) * 1.0; // 0.5x to 1.5x distance

          const targetPos = {
            x: basePos.x + (Math.random() - 0.5) * randomFactor * 2,
            y: basePos.y + (Math.random() - 0.5) * randomFactor * 2,
            z: basePos.z * distanceMultiplier + (Math.random() - 0.5) * randomFactor
          };

          window.DEBUG && console.log('🎯 Randomized camera target for', pageId, 'base:', basePos, 'randomized:', targetPos);

          if (ThreeDBackground && ThreeDBackground.cameraTargetPosition) {
            // Smooth camera transition over 1 second (faster like original)
            const startPos = ThreeDBackground.cameraTargetPosition.clone();
            const endPos = new THREE.Vector3(targetPos.x, targetPos.y, targetPos.z);

            let startTime = Date.now();
            const duration = 1000; // 1 second

            const animateCamera = () => {
              const elapsed = Date.now() - startTime;
              const progress = Math.min(elapsed / duration, 1);

              // Use easeInOutCubic for smooth animation
              const easedProgress = progress < 0.5
                ? 4 * progress * progress * progress
                : 1 - Math.pow(-2 * progress + 2, 3) / 2;

              const currentPos = startPos.clone().lerp(endPos, easedProgress);
              ThreeDBackground.cameraTargetPosition.copy(currentPos);
              // Also update the movement system target for smooth transition
              ThreeDBackground.cameraMovement.targetPosition.x = currentPos.x;
              ThreeDBackground.cameraMovement.targetPosition.y = currentPos.y;
              ThreeDBackground.cameraMovement.targetPosition.z = currentPos.z;

              if (progress < 1) {
                requestAnimationFrame(animateCamera);
              }
            };

            animateCamera();

          }
        },

        triggerTransitionEffects() {
          if (!ThreeDBackground || !ThreeDBackground.scene) return;

          // Create a dramatic visual effect during page transitions
          const effectNotes = ['C4', 'D4', 'E4', 'F4', 'G4', 'A4', 'B4', 'C5'];

          // Trigger rapid fire note pulses in sequence
          effectNotes.forEach((note, index) => {
            setTimeout(() => {
              AppState.visualQueue.push(note);

              // Add some extra intensity by triggering multiple related notes
              if (index % 2 === 0) {
                const harmonicNote = note.replace('4', '3'); // Drop an octave
                setTimeout(() => AppState.visualQueue.push(harmonicNote), 50);
              }
            }, index * 40);
          });

          // Add a cascading wave effect after the rapid sequence
          setTimeout(() => {
            const waveNotes = ['G5', 'E5', 'C5', 'A4', 'F4', 'D4'];
            waveNotes.forEach((note, index) => {
              setTimeout(() => AppState.visualQueue.push(note), index * 60);
            });
          }, 320);
        }
      };

      // Initialize remaining systems (3D background already initialized)
      window.DEBUG && console.log('📄 Initializing Page Manager...');
      PageManager.init();

      window.DEBUG && console.log('🔄 Initializing Page Transitions...');
      PageTransition.init();

      window.DEBUG && console.log('📱 Initializing Mobile Menu...');
      MobileMenu.init();

      window.DEBUG && console.log('✨ Initializing Interactive Effects...');
      InteractiveEffects.init();
      InteractiveEffects.setupDeviceOrientation();

      // The rainbow borders are normally driven from ThreeDBackground.animate,
      // which does not exist on a text page. They are the site's identity and
      // cost nothing, so they get their own loop instead of being dropped.
      if (!(ThreeDBackground && ThreeDBackground.running) && typeof InteractiveEffects.updateElements === 'function') {
        const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) {
          const tick = () => { InteractiveEffects.updateElements(); requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        }
      }
      
      // InteractiveEffects will be updated by ThreeDBackground animation loop for optimal performance
      window.DEBUG && console.log('🚀 InteractiveEffects will use shared animation loop (ThreeDBackground.animate)...');
      if (window.InteractiveEffects && typeof InteractiveEffects.updateElements === 'function') {
        // Force initial update to kick-start all elements
        window.DEBUG && console.log('🎬 Forcing initial InteractiveEffects update...');
        InteractiveEffects.updateElements();
        window.DEBUG && console.log('✅ InteractiveEffects will be updated by shared animation loop');
        
        // Double check Reality Engine button specifically
        setTimeout(() => {
          const realityBtn = document.getElementById('reality-engine-btn');
          if (realityBtn) {
            window.DEBUG && console.log('🌈 Reality Engine button found:', realityBtn);
            window.DEBUG && console.log('🔍 Physics object:', realityBtn._physics);
            window.DEBUG && console.log('🎨 Current --angle:', realityBtn.style.getPropertyValue('--angle'));
            
            // If physics object is missing, create it manually
            if (!realityBtn._physics) {
              window.DEBUG && console.log('⚡ Creating missing physics object for Reality Engine button');
              const rect = realityBtn.getBoundingClientRect();
              realityBtn._physics = {
                angle: 45,
                x: rect.width / 2,
                y: rect.height / 2,
                targetX: rect.width / 2,
                targetY: rect.height / 2,
                velocityX: 0,
                velocityY: 0
              };
            }
            
            // Force a manual angle update
            realityBtn._physics.angle = 45; // Start with a visible angle
            realityBtn.style.setProperty('--angle', '45deg');
            window.DEBUG && console.log('🔄 Manually set Reality Engine angle to 45deg');
          }
        }, 100);
      }

      window.DEBUG && console.log('⚙️ Initializing page-specific scripts...');
      PageTransition.initializePageSpecificScripts();

      // Initialize contact dropdown functionality
      window.DEBUG && console.log('📞 Initializing contact dropdowns...');
      const contactDropdownBtn = document.getElementById('contact-dropdown-btn');
      const contactDropdown = document.getElementById('contact-dropdown');
      const mobileContactDropdownBtn = document.getElementById('mobile-contact-dropdown-btn');
      const mobileContactDropdown = document.getElementById('mobile-contact-dropdown');

      if (contactDropdownBtn && contactDropdown) {
        contactDropdownBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          contactDropdown.classList.toggle('hidden');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (!contactDropdownBtn.contains(e.target) && !contactDropdown.contains(e.target)) {
            contactDropdown.classList.add('hidden');
          }
        });
      }

      if (mobileContactDropdownBtn && mobileContactDropdown) {
        mobileContactDropdownBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          mobileContactDropdown.classList.toggle('hidden');
        });
      }

      // Set initial camera position based on current page
      const currentPath = window.location.pathname;
      let currentPage = 'hero';
      if (currentPath.includes('/work')) {
        currentPage = 'work';
      } else if (currentPath.includes('/about')) {
        currentPage = 'about';
      } else if (currentPath.includes('/blog')) {
        currentPage = 'blog';
      }

      window.DEBUG && console.log('🎯 Current page detected:', currentPage, 'from path:', currentPath);

      // Set initial camera position without animation - immediately
      const cameraPositions = {
        'hero': { x: 0, y: 0, z: 2 },
        'work': { x: -2, y: 1, z: 3 },
        'about': { x: 2, y: -1, z: 4 },
        'blog': { x: 0, y: 2, z: 3 }
      };

      const initialPos = cameraPositions[currentPage] || cameraPositions['hero'];
      if (ThreeDBackground && ThreeDBackground.cameraTargetPosition) {
        ThreeDBackground.cameraTargetPosition.set(initialPos.x, initialPos.y, initialPos.z);
        window.DEBUG && console.log('📷 Camera position set to:', initialPos);

        // Force a render after camera position is set
        setTimeout(() => {
          if (ThreeDBackground.renderer && ThreeDBackground.scene && ThreeDBackground.camera) {
            ThreeDBackground.renderer.render(ThreeDBackground.scene, ThreeDBackground.camera);
            window.DEBUG && console.log('🎬 Forced render completed');
          }
        }, 100);
      }

      // Final animation verification (only where there is an animation to verify)
      setTimeout(() => {
        if (hasThree && !(ThreeDBackground && ThreeDBackground.running) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          console.warn('ThreeDBackground animation may not be running');
        }
        window.DEBUG && console.log('✅ All animations should be running');
      }, 200);
    });
  </script>

