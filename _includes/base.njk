          }
        },

        enableGyroOnSoundUnmute() {
          // Only for mobile devices and if not already enabled
          if (!('ontouchstart' in window)) return;

          window.DEBUG && console.log('📱 Attempting to enable gyro on sound unmute...');

          // For iOS devices that require permission
          if (typeof DeviceOrientationEvent.requestPermission === 'function') {
            DeviceOrientationEvent.requestPermission()
              .then(permissionState => {
                if (permissionState === 'granted') {
                  if (!this.gyroEnabled) {
                    window.addEventListener('deviceorientation', (e) => this.onDeviceMove(e));
                    this.gyroEnabled = true;
                    window.DEBUG && console.log('📱 Gyro enabled after sound unmute');
                  }
                } else {
                  window.DEBUG && console.log('📱 Device orientation permission denied');
                }
              })
              .catch(error => {
                console.warn('📱 Device orientation permission request failed:', error);
              });
          } else {
            // For Android and other devices that don't require explicit permission
            if (!this.gyroEnabled) {
              window.addEventListener('deviceorientation', (e) => this.onDeviceMove(e));
