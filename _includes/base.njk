    {#
      Posts for this page's project, emitted for the devlog panel to read.
      A page opts in by setting `project:` in its front matter; every other
      page renders nothing here. Each record carries Eleventy's own `url`,
      so a card can never link somewhere that was not built.
    #}
    {% if project %}
    <script id="project-posts-data" type="application/json">
      {{ collections.post | byProject(project) | toCardData | dump | safe }}
    </script>
    {% endif %}

