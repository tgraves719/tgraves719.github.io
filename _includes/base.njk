      };

      // The mute (site-audio.js holds it). It silences everything the site can reach:
      // the music, the instruments in frames, YouTube.
      // Pressing play on a song or a video lifts it. The site has no sound of its own.
      const SiteAudio = window.SiteAudio;
      function showMute() {
        const on = !SiteAudio.muted;
        soundOnIcon.classList.toggle('hidden', !on);
        soundOffIcon.classList.toggle('hidden', on);
