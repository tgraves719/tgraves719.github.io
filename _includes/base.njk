        },

        initRealityEngineButton() {
          // Reality Engine Button with Loading System - only initialize if button exists
          const realityEngineBtn = document.getElementById('reality-engine-btn');
          const noVrModal = document.getElementById('no-vr-modal');
          const closeNoVrModalBtn = document.getElementById('close-no-vr-modal');

          if (realityEngineBtn) {
            // Remove any existing event listeners to prevent duplicates
            const newRealityEngineBtn = realityEngineBtn.cloneNode(true);
            realityEngineBtn.parentNode.replaceChild(newRealityEngineBtn, realityEngineBtn);

            // Let InteractiveEffects handle this button with its normal initialization
            if (window.InteractiveEffects) {
              // Simply re-run init to pick up the new element
              InteractiveEffects.rainbowElements = Array.from(document.querySelectorAll('.interactive-rainbow'));
              
              // Find and re-initialize just this button
              const rect = newRealityEngineBtn.getBoundingClientRect();
              Object.assign(newRealityEngineBtn.dataset, {
                angle: '0',
                x: rect.width / 2,
                y: rect.height / 2,
                targetX: rect.width / 2,
                targetY: rect.height / 2,
                velocityX: '0',
                velocityY: '0'
              });

              // Set initial CSS custom properties - reality engine starts at 45 degrees
              newRealityEngineBtn.style.setProperty('--x', `${rect.width / 2}px`);
              newRealityEngineBtn.style.setProperty('--y', `${rect.height / 2}px`);
              newRealityEngineBtn.style.setProperty('--angle', '45deg');

              // Initialize physics object
              newRealityEngineBtn._physics = {
                angle: 45, // Reality Engine button starts with visible rotation
                x: rect.width / 2,
                y: rect.height / 2,
                targetX: rect.width / 2,
                targetY: rect.height / 2,
                velocityX: 0,
                velocityY: 0
              };

              // Re-add event listeners
              newRealityEngineBtn.addEventListener('mouseenter', (e) => InteractiveEffects.onMouseEnter(e));
              newRealityEngineBtn.addEventListener('mouseleave', (e) => InteractiveEffects.onMouseLeave(e));
              newRealityEngineBtn.addEventListener('mousemove', (e) => InteractiveEffects.onMouseMove(e));
            }

            newRealityEngineBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              e.stopPropagation(); // Prevent event bubbling that could trigger sound

              // Visual effects will be handled by melody system

              // INSTANT visual feedback - start loading animation immediately
              const loadingPromise = LoadingSystem.showFullLoading('Initializing Reality Engine...');

              // PARALLEL execution - all these happen while animation runs
              const soundSetupPromise = (async () => {
                // Only setup sound engine, don't automatically enable it
                if (!soundEngine.isSetup) {
                  await soundEngine.setup();
                }
                // Play click sound only if sound is already enabled
                if (AppState.isSoundEnabled) {
                  soundEngine.playClickSound();
                }
              })();

              const pagePreloadPromise = fetch('/work/');

              const webxrCheckPromise = (async () => {
                try {
                  if (navigator.xr && await navigator.xr.isSessionSupported('immersive-vr')) {
                    console.log('✅ WebXR VR session supported');
                    return { hasVR: true };
                  } else {
                    console.log('❌ WebXR not supported');
                    return { hasVR: false };
                  }
                } catch (error) {
                  console.error('WebXR check failed:', error);
                  return { hasVR: false };
                }
              })();

              // Wait for all parallel operations to complete
              const [loadingResult, soundResult, pageResult, webxrResult] = await Promise.all([
                loadingPromise,
                soundSetupPromise,
                pagePreloadPromise,
                webxrCheckPromise
              ]);

              // Navigate immediately after loading animation completes
              if (webxrResult.hasVR) {
                window.location.href = '/work/';
              } else {
                if (noVrModal) {
                  noVrModal.classList.remove('hidden');
                }
              }
            });
          }

          // Close VR Modal
          if (closeNoVrModalBtn && noVrModal) {
            // Remove existing event listener and add new one
            const newCloseBtn = closeNoVrModalBtn.cloneNode(true);
            closeNoVrModalBtn.parentNode.replaceChild(newCloseBtn, closeNoVrModalBtn);

            newCloseBtn.addEventListener('click', () => {
              noVrModal.classList.add('hidden');
              if (AppState.isSoundEnabled) {
                soundEngine.playClickSound();
              }
            });
          }
        },

