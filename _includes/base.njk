            requestAnimationFrame(tick);
            if (!SiteAudio.playing) return;
            this.el.style.setProperty('--np', `rgb(${SiteAudio.color.join(',')})`);
            this.el.style.setProperty('--np-glow', (0.2 + SiteAudio.level * 0.8).toFixed(2));
