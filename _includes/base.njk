  <script>
    // App State
    const AppState = {
      activePage: 'hero',
      isTransitioning: false,
      pageToShowAfterTransition: null,
      transitionTimeoutId: null,
      visualQueue: [],
    };

    // Wait for the instrument's libraries, but never wait forever: everything
    // after this gate -- the navigation, the mobile menu, the rainbow borders --
    // used to be unreachable if a CDN was slow or blocked, and is unreachable
    // by definition on a page that does not load the libraries at all.
    function waitForLibraries() {
      return new Promise((resolve) => {
        if (!window.HAS_INSTRUMENT) return resolve();
        const deadline = Date.now() + 4000;
        function checkLibraries() {
          if (typeof THREE !== 'undefined') {
            resolve();
          } else if (Date.now() > deadline) {
            console.warn('Instrument libraries did not load; continuing without them.');
            resolve();
          } else {
            setTimeout(checkLibraries, 100);
          }
        }
        checkLibraries();
      });
    }

