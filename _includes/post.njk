---
layout: base.njk
---
<section class="py-16">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8">
      {% if date %}
      <p class="text-sm text-gray-500 mb-2">{{ date | postDate }}</p>
      {% endif %}
      <h1 class="text-4xl tracking-tight uppercase font-bold text-white" style="letter-spacing: 0.1em;">{{ title }}</h1>
    </div>
    {% if videoId %}
    <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden mb-12 shadow-lg bg-black">
      <iframe src="https://www.youtube.com/embed/{{ videoId }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="w-full h-full"></iframe>
    </div>
    {% elif image %}
    <img src="/{{ image }}" alt="{{ title }}" class="w-full h-auto rounded-xl mb-12 shadow-lg">
    {% endif %}
    <div class="prose prose-invert prose-lg max-w-none text-gray-300">
      {{ content | safe }}
    </div>
    
    <div class="mt-16 mb-8">
      <a href="/blog/" id="back-link" class="interactive-rainbow inline-block px-6 py-3 rounded-md font-semibold uppercase tracking-wider">&larr; Back</a>
    </div>
  </div>
</section>

<script>
  // Simple back button that works exactly like browser back button
  function setupBackButton() {
    const backLink = document.getElementById('back-link');
    if (!backLink) return;
    
    // Remove the href to prevent default link behavior
    backLink.removeAttribute('href');
    backLink.style.cursor = 'pointer';
    
    // Set generic back text
    backLink.textContent = '← Back';
    
    console.log('✅ Back button configured to use browser history');
  }
  
  // Run immediately and also on DOMContentLoaded
  setupBackButton();
  document.addEventListener('DOMContentLoaded', setupBackButton);
  
  // Setup back link page transitions
  function setupBackLinkTransitions() {
    const backLink = document.getElementById('back-link');
    if (!backLink) return;
    
    // Remove existing listeners
    backLink.replaceWith(backLink.cloneNode(true));
    const newBackLink = document.getElementById('back-link');
    
    // Re-initialize InteractiveEffects for all elements 
    if (window.InteractiveEffects) {
      // Force re-scan of all interactive elements
      InteractiveEffects.rainbowElements = Array.from(document.querySelectorAll('.interactive-rainbow'));
      
      // Initialize the new back button element
      InteractiveEffects.rainbowElements.forEach(el => {
        if (!el._physics && el.classList.contains('interactive-rainbow')) {
          const rect = el.getBoundingClientRect();
          Object.assign(el.dataset, {
            angle: '0',
            x: rect.width / 2,
            y: rect.height / 2,
            targetX: rect.width / 2,
            targetY: rect.height / 2,
            velocityX: '0',
            velocityY: '0'
          });

          // Set initial CSS custom properties
          el.style.setProperty('--x', `${rect.width / 2}px`);
          el.style.setProperty('--y', `${rect.height / 2}px`);
          const initialAngle = el.id === 'reality-engine-btn' ? 45 : 0;
          el.style.setProperty('--angle', `${initialAngle}deg`);

          // Initialize physics object
          el._physics = {
            angle: initialAngle,
            x: rect.width / 2,
            y: rect.height / 2,
            targetX: rect.width / 2,
            targetY: rect.height / 2,
            velocityX: 0,
            velocityY: 0
          };

          // Add mouse event listeners
          el.addEventListener('mouseenter', (e) => InteractiveEffects.onMouseEnter(e));
          el.addEventListener('mouseleave', (e) => InteractiveEffects.onMouseLeave(e));
          el.addEventListener('mousemove', (e) => InteractiveEffects.onMouseMove(e));
        }
      });
    }
    
    // Make the back link use browser history (like back button)
    newBackLink.addEventListener('click', function(e) {
      e.preventDefault();
      
      // Check if there's history to go back to
      if (window.history.length > 1) {
        window.history.back();
      } else {
        // Fallback if no history (e.g., direct link to post)
        if (typeof PageTransition !== 'undefined') {
          PageTransition.navigateToPage('/blog/');
        } else {
          window.location.href = '/blog/';
        }
      }
    });
  }
  
  // Setup transitions immediately and on DOM ready
  setupBackLinkTransitions();
  document.addEventListener('DOMContentLoaded', setupBackLinkTransitions);
</script>